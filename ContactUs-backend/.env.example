# Server
PORT=5000
NODE_ENV=development

# MongoDB
# Local MongoDB example: mongodb://127.0.0.1:27017/portfolio_contact
# MongoDB Atlas example: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/portfolio_contact
MONGO_URI=mongodb://127.0.0.1:27017/portfolio_contact

# Gmail SMTP (free, for now) — use an App Password, NOT your normal Gmail password.
# Generate one at: https://myaccount.google.com/apppasswords (requires 2-Step Verification enabled)
GMAIL_USER=your-gmail-account@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
# Local development only when a corporate proxy/antivirus intercepts TLS.
# Never enable this in production.
SMTP_ALLOW_SELF_SIGNED_CERT=false

# Where the "someone contacted us" notification email should be delivered.
# Add any number of recipients as a JSON array.
CONTACT_RECEIVER_EMAILS=["company-inbox@gmail.com","owner@example.com"]
CONTACT_RECEIVER_EMAIL=company-inbox@gmail.com

# JWT auth (admin-only private routes)
# Generate a strong random secret, e.g.: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1h

# The frontend origin allowed to call this API with credentials (cookies).
FRONTEND_URL=http://localhost:5173

# Used only by scripts/createAdmin.js to seed the first admin account.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
