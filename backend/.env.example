# Server
PORT=5000

# MongoDB
# Local MongoDB example: mongodb://127.0.0.1:27017/portfolio_contact
# MongoDB Atlas example: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/portfolio_contact
MONGO_URI=mongodb://127.0.0.1:27017/portfolio_contact

# Gmail SMTP (free, for now) — use an App Password, NOT your normal Gmail password.
# Generate one at: https://myaccount.google.com/apppasswords (requires 2-Step Verification enabled)
GMAIL_USER=your-gmail-account@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# Where the "someone contacted us" notification email should be delivered.
# Defaults to GMAIL_USER if not set.
CONTACT_RECEIVER_EMAIL=company-inbox@gmail.com
